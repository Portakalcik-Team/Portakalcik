  m_EditorClassIdentifier: Assembly-CSharp::MapGenerator
  mapText: "\u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588 \u2588\r\n\u2588 S . m \u2588 . . . \u2588 . . . \u2588 . . . \u2588 l . . \u2588\r\n\u2588 . \u2588 . \u2588 . \u2588 . \u2588 . \u2588 \u2588 \u2588 . \u2588 . \u2588 \u2588 . \u2588 \u2588\r\n\u2588 1 \u2588 . . . \u2588 . . . . . . . 2 . . . . . \u2588\r\n\u2588 . \u2588 \u2588 \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 \u2588\r\n\u2588 . . 2 . . m . . . . . . . . m . . . . \u2588\r\n\u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588\r\n\u2588 . 3 . \u2588 . . . \u2588 . . . \u2588 2 . . \u2588 . . . \u2588\r\n\u2588 . \u2588 \u2588 \u2588 . \u2588 . \u2588 . \u2588 \u2588 \u2588 . \u2588 . \u2588 \u2588 \u2588 . \u2588\r\n\u2588 . 4 . . . \u2588 . . . . . . . \u2588 . . . 3 . \u2588\r\n\u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588\r\n\u2588 . . 5 . . . . \u2588 . m . \u2588 . . . . . l . \u2588\r\n\u2588 . \u2588 D \u2588 . \u2588 . \u2588 . \u2588 D \u2588 . \u2588 . \u2588 D \u2588 . \u2588\r\n\u2588 . \u2588 . m 1 \u2588 . . . . . . . . . \u2588 . . . \u2588\r\n\u2588 . \u2588 \u2588 \u2588 . \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 . \u2588 \u2588 \u2588\r\n\u2588 . . . . . . . . . . . . . . 3 . . . . \u2588\r\n\u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588\r\n\u2588 4 . . \u2588 . . . \u2588 m . . . \u2588 . l . . . . \u2588\r\n\u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 . \u2588 \u2588 \u2588 . \u2588\r\n\u2588 . . 2 . . . . 5 . . . . . . . . . 1 . \u2588\r\n\u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u2588 . \u2588 \u2588 \u